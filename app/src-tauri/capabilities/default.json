{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "what the Iris window is allowed to call",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-start-resize-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-close",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-unminimize",
    "core:window:allow-set-focus",
    "core:window:allow-is-maximized",
    "opener:default",
    "opener:allow-open-url",
    "opener:allow-reveal-item-in-dir",
    "notification:default",
    "process:default",
    "process:allow-restart",
    "allow-engine-status",
    "allow-set-tick-details",
    "allow-list-rules",
    "allow-list-apps",
    "allow-forget-app",
    "allow-list-alerts",
    "allow-resize-connection-prompts",
    "allow-report-display-scale",
    "allow-ack-alert",
    "allow-decide-alert",
    "allow-get-usage",
    "allow-get-adapter-usage",
    "allow-kill-connection",
    "allow-get-enrichment",
    "allow-list-plugins",
    "allow-grant-plugin",
    "allow-set-plugin-enabled",
    "allow-list-proposals",
    "allow-reject-proposal",
    "allow-get-plugin-panel",
    "allow-reverse-dns",
    "allow-install-service",
    "allow-uninstall-service",
    "allow-rule-add",
    "allow-rule-remove",
    "allow-rule-set-enabled",
    "allow-rule-import",
    "allow-proposal-accept",
    "allow-get-launch-at-login",
    "allow-set-launch-at-login",
    "allow-save-download",
    "allow-app-icon",
    "allow-check-installer-update",
    "allow-install-installer-update"
  ]
}
