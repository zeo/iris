{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Iris",
  "version": "0.2.1",
  "identifier": "lt.rot.iris",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "cargo build --release -p iris-service && pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Iris",
        "width": 1180,
        "height": 820,
        "minWidth": 820,
        "minHeight": 600,
        "decorations": false,
        "transparent": false,
        "resizable": true,
        "zoomHotkeysEnabled": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; base-uri 'none'; object-src 'none'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    },
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "resources": {
      "resources/geo/dbip-country.mmdb": "resources/geo/dbip-country.mmdb"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "copyright": "© rot",
    "shortDescription": "Firewall and network monitor",
    "longDescription": "Iris watches every app's network traffic and puts you in control of what is allowed to connect. A native firewall and live network monitor."
  }
}
